# Backend Environment Variables
# Copy to .env and adjust as needed

# LOCAL DEVELOPMENT
# MONGO_URI=mongodb://localhost:27017

# PRODUCTION - MongoDB Atlas
# Substitua pelos valores reais gerados no MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vetflow?retryWrites=true&w=majority&ssl=true
# Database name. Outside production (APP_ENV development/demo) it MUST NOT be the
# production database "vetflow" — the app refuses to start if it is (see APP_ENV
# below). Use "vetflow_dev" locally and "vetflow_demo" for the public demo; only
# APP_ENV=production uses MONGO_DB=vetflow.
MONGO_DB=vetflow_dev
PORT=8080

# Application environment: development (default), demo, or production.
# The app refuses to start unless JWT_SECRET is set, in EVERY environment.
#
# Use APP_ENV=demo for the public portfolio demo. In demo/development the
# database is seeded with fake data on boot (visitor login enabled), so a
# NON-production environment MUST NOT point MONGO_DB at the production
# database "vetflow" — the app refuses to start if it does. Use a separate
# database such as "vetflow_demo".
APP_ENV=development
# Secret used to sign JWTs. REQUIRED in every environment (no dev fallback).
# Use a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-to-a-long-random-secret

# CORS: comma-separated list of allowed origins (e.g. https://app.example.com,https://admin.example.com).
# Leave empty to allow all origins (*) — convenient for local development.
# CORS_ALLOWED_ORIGINS=

# Rate limit (per client IP, per minute) for POST /auth/login and POST /auth/register.
# Default is 10 when unset or invalid. Set to 0 (or any value <= 0) to disable limiting.
# AUTH_RATE_LIMIT_PER_MIN=10

# Demo reset endpoint (POST /admin/reset-demo). When set (and APP_ENV is NOT
# production), callers presenting this value in the X-Admin-Token header can
# wipe and re-seed the demo database — used by a scheduled job to reset the
# public demo. Leave UNSET in production: the endpoint is disabled there and
# the seed layer refuses to run anyway. Use a long random value.
# ADMIN_RESET_TOKEN=change-me-to-a-long-random-secret

# Reset automatico da demo no boot (apenas APP_ENV=demo). Quando o backend
# sobe em modo demo, ele re-semeia o banco SE o ultimo seed foi ha mais de
# DEMO_RESET_INTERVAL_HOURS horas (default 6). Como o Render free tier hiberna
# quando ocioso e acorda no proximo acesso, a demo se auto-limpa sem nenhum
# agendador externo. A janela evita apagar dados logo apos um seed recente
# (ex: um redeploy no meio de uma sessao). 0 = reseta em todo boot.
# DEMO_RESET_INTERVAL_HOURS=6

# Controle de acesso em PRODUCAO (ignorado em demo/development, que ficam
# abertos). Fecha o cadastro pra manter prod restrito a clientes controlados
# em infra gratuita.
#
# REGISTER_INVITE_CODE: codigo de convite exigido no POST /auth/register em
# producao. Com codigo setado, so quem apresenta o codigo correto cria conta.
# VAZIO em producao = cadastro classico FECHADO (voce cria as contas). Fora de
# producao e ignorado.
# REGISTER_INVITE_CODE=um-codigo-aleatorio-longo
#
# MAX_PRODUCTION_USERS: teto de contas em producao (rede de seguranca contra
# estourar a infra gratuita). Cobre cadastro classico, social e OAuth. 0 ou
# ausente = sem teto. Ignorado fora de producao.
# MAX_PRODUCTION_USERS=50

# E-mail notifications (fase 1)
# Habilita o agendador diario que envia lembretes de retorno/vacina por e-mail.
EMAIL_NOTIFICATIONS_ENABLED=true
# SMTP: se SMTP_HOST ficar vazio, o mailer roda em modo "log-only" (nao envia).
# SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USER=seu-usuario
# SMTP_PASS=sua-senha-ou-app-password
# SMTP_FROM=no-reply@suaclinica.com
SMTP_FROM_NAME=VetFlow
