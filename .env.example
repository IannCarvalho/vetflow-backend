# Backend Environment Variables
# Copy to .env and adjust as needed

# LOCAL DEVELOPMENT
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB=vetflow

# PRODUCTION - MongoDB Atlas
# Substitua pelos valores reais gerados no MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vetflow?retryWrites=true&w=majority&ssl=true
MONGO_DB=vetflow

PORT=8080

# Application environment: development (default) or production.
# In production the app refuses to start unless JWT_SECRET is set.
APP_ENV=development

# Secret used to sign JWTs. REQUIRED in production. Use a long random value.
# JWT_SECRET=change-me-to-a-long-random-secret
