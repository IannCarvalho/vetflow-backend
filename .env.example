# Backend Environment Variables
# Copy to .env and adjust as needed

# LOCAL DEVELOPMENT
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB=vetflow

# PRODUCTION - MongoDB Atlas
# Substitua pelos valores reais gerados no MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vetflow?retryWrites=true&w=majority&ssl=true
MONGO_DB=vetflow
PORT=8080

# Application environment: development (default), demo, or production.
# The app refuses to start unless JWT_SECRET is set, in EVERY environment.
#
# Use APP_ENV=demo for the public portfolio demo. In demo/development the
# database is seeded with fake data on boot (visitor login enabled), so a
# NON-production environment MUST NOT point MONGO_DB at the production
# database "vetflow" — the app refuses to start if it does. Use a separate
# database such as "vetflow_demo".
APP_ENV=development
# Secret used to sign JWTs. REQUIRED in every environment (no dev fallback).
# Use a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-to-a-long-random-secret

# CORS: comma-separated list of allowed origins (e.g. https://app.example.com,https://admin.example.com).
# Leave empty to allow all origins (*) — convenient for local development.
# CORS_ALLOWED_ORIGINS=

# Rate limit (per client IP, per minute) for POST /auth/login and POST /auth/register.
# Default is 10 when unset or invalid. Set to 0 (or any value <= 0) to disable limiting.
# AUTH_RATE_LIMIT_PER_MIN=10

# E-mail notifications (fase 1)
# Habilita o agendador diario que envia lembretes de retorno/vacina por e-mail.
EMAIL_NOTIFICATIONS_ENABLED=true
# SMTP: se SMTP_HOST ficar vazio, o mailer roda em modo "log-only" (nao envia).
# SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USER=seu-usuario
# SMTP_PASS=sua-senha-ou-app-password
# SMTP_FROM=no-reply@suaclinica.com
SMTP_FROM_NAME=VetFlow
