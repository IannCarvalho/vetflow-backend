# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.so.*
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Dependency directories
vendor/

# Go workspace file
go.work

# Environment files
.env
.env.local
.env.*.local
.env.production

# Downloaded CLI archive (should not be tracked)
flyctl.zip

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build output
bin/
dist/
.vercel

# Workflow/agent task metadata (not source)
.agents/

# Agent skills tooling (installed via `npx skills`, not project source).
# The agent/ subtree ships example .go files that import packages absent from
# go.mod, which break `go build ./...` and `go mod tidy` at the repo root.
# The whole tree is ignored EXCEPT agent/go.mod: that nested module is a
# deliberate boundary that makes the Go toolchain stop descending into agent/
# from the root module's ./... wildcard. Keep it tracked so the fix survives.
agent/*
!agent/go.mod
.claude/
.kiro/
skills-lock.json
